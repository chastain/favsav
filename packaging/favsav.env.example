# Secrets for favsav.  This file is read by systemd's EnvironmentFile=.
#
# Keep it readable by the favsav service user only:
#     chown root:favsav /etc/favsav/favsav.env
#     chmod 0640 /etc/favsav/favsav.env
#
# The API key from Jellyfin: Dashboard -> Advanced -> API Keys.
FAVSAV_API_KEY=

# The password for the SMTP account.  Leave it empty to send no mail at all.
FAVSAV_SMTP_PASSWORD=
